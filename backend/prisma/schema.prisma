generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Component {
  id                   String                 @id
  handbookVersionId    String
  code                 String
  name                 String
  type                 ComponentType
  originalType         String?
  creditPoints         Int?
  rawData              Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  sourceUrl            String?
  HandbookVersion      HandbookVersion        @relation(fields: [handbookVersionId], references: [id], onDelete: Cascade)
  DegreeComponent      DegreeComponent[]
  RequirementGroup     RequirementGroup[]
  RequirementItem      RequirementItem[]
  SubjectRequisiteItem SubjectRequisiteItem[]
  RiasecScore            RiasecScore[]
  RiasecSubcategoryScore RiasecSubcategoryScore[]

  @@unique([handbookVersionId, code])
  @@index([code])
  @@index([type])
}

model Degree {
  id                   String                 @id
  handbookVersionId    String
  code                 String
  name                 String
  creditPoints         Int?
  description          String?
  rawData              Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  HandbookVersion      HandbookVersion        @relation(fields: [handbookVersionId], references: [id], onDelete: Cascade)
  DegreeComponent      DegreeComponent[]
  RequirementGroup     RequirementGroup[]
  StudyPlan            StudyPlan[]
  SubjectRequisiteItem SubjectRequisiteItem[]
  RiasecScore            RiasecScore[]
  RiasecSubcategoryScore RiasecSubcategoryScore[]

  @@unique([handbookVersionId, code])
  @@index([code])
}

model DegreeComponent {
  id                   String            @id
  degreeId             String
  componentId          String?
  parentGroupId        String?
  rawComponentCode     String?
  rawComponentName     String?
  requiredCreditPoints Int?
  groupPath            String?
  containerPath        String?
  sortOrder            Int?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime
  authoritative        Boolean?
  rawComponentType     String?
  rawData              Json?
  relationshipKind     String?
  Component            Component?        @relation(fields: [componentId], references: [id])
  Degree               Degree            @relation(fields: [degreeId], references: [id], onDelete: Cascade)
  RequirementGroup     RequirementGroup? @relation(fields: [parentGroupId], references: [id])

  @@index([componentId])
  @@index([degreeId])
  @@index([parentGroupId])
  @@index([relationshipKind])
}

model HandbookVersion {
  id                     String                   @id
  universityId           String
  year                   Int
  sourceUrl              String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  Component              Component[]
  Degree                 Degree[]
  University             University               @relation(fields: [universityId], references: [id], onDelete: Cascade)
  SourceRecord           SourceRecord[]
  Subject                Subject[]
  SubjectAccessCondition SubjectAccessCondition[]
  UnresolvedReference    UnresolvedReference[]

  @@unique([universityId, year])
  @@index([year])
}

model RequirementGroup {
  id                     String             @id
  degreeId               String?
  componentId            String?
  parentGroupId          String?
  sourceGroupId          String?
  title                  String?
  description            String?
  logic                  RequirementLogic   @default(UNKNOWN)
  requiredCreditPoints   Int?
  maximumCreditPoints    Int?
  sortOrder              Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime
  authoritative          Boolean?
  nodeType               String?
  rawData                Json?
  sourceIndex            Int?
  sourcePath             String?
  sourceUrl              String?
  status                 String?
  DegreeComponent        DegreeComponent[]
  Component              Component?         @relation(fields: [componentId], references: [id], onDelete: Cascade)
  Degree                 Degree?            @relation(fields: [degreeId], references: [id], onDelete: Cascade)
  RequirementGroup       RequirementGroup?  @relation("RequirementGroupToRequirementGroup", fields: [parentGroupId], references: [id], onDelete: Cascade)
  other_RequirementGroup RequirementGroup[] @relation("RequirementGroupToRequirementGroup")
  RequirementItem        RequirementItem[]

  @@index([componentId])
  @@index([degreeId])
  @@index([parentGroupId])
  @@index([sourceGroupId])
  @@index([nodeType])
  @@index([status])
}

model RequirementItem {
  id                 String              @id
  requirementGroupId String
  itemType           RequirementItemType
  subjectId          String?
  componentId        String?
  rawCode            String?
  rawName            String?
  creditPoints       Int?
  sourceUrl          String?
  sortOrder          Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  authoritative      Boolean?
  rawData            Json?
  Component          Component?          @relation(fields: [componentId], references: [id])
  RequirementGroup   RequirementGroup    @relation(fields: [requirementGroupId], references: [id], onDelete: Cascade)
  Subject            Subject?            @relation(fields: [subjectId], references: [id])

  @@index([componentId])
  @@index([requirementGroupId])
  @@index([subjectId])
}

model SourceRecord {
  id                String          @id
  handbookVersionId String
  entityType        String
  entityCode        String?
  sourceUrl         String?
  retrievedAt       DateTime
  sha256            String?
  rawData           Json?
  createdAt         DateTime        @default(now())
  HandbookVersion   HandbookVersion @relation(fields: [handbookVersionId], references: [id], onDelete: Cascade)

  @@index([entityType, entityCode])
  @@index([handbookVersionId])
}

model StudyPlan {
  id                  String          @id
  degreeId            String
  sourcePlanId        String?
  title               String
  description         String?
  sourceUrl           String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime
  handbookYear        Int?
  isFormalRequirement Boolean?
  pathway             String?
  rawData             Json?
  sourceType          String?
  totalCreditPoints   Int?
  variantNumber       Int?
  Degree              Degree          @relation(fields: [degreeId], references: [id], onDelete: Cascade)
  StudyPlanYear       StudyPlanYear[]

  @@index([degreeId])
}

model StudyPlanItem {
  id                String            @id
  studyPlanPeriodId String
  itemType          StudyPlanItemType
  subjectId         String?
  rawCode           String?
  title             String
  creditPoints      Int?
  sourceUrl         String?
  numberOfPeriods   Int?
  sortOrder         Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  rawData           Json?
  StudyPlanPeriod   StudyPlanPeriod   @relation(fields: [studyPlanPeriodId], references: [id], onDelete: Cascade)
  Subject           Subject?          @relation(fields: [subjectId], references: [id])

  @@index([studyPlanPeriodId])
  @@index([subjectId])
}

model StudyPlanPeriod {
  id                String          @id
  studyPlanYearId   String
  name              String
  sortOrder         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  periodNumber      Int?
  periodType        String?
  totalCreditPoints Int?
  StudyPlanItem     StudyPlanItem[]
  StudyPlanYear     StudyPlanYear   @relation(fields: [studyPlanYearId], references: [id], onDelete: Cascade)

  @@index([studyPlanYearId])
}

model StudyPlanYear {
  id              String            @id
  studyPlanId     String
  name            String
  sortOrder       Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  yearNumber      Int?
  StudyPlanPeriod StudyPlanPeriod[]
  StudyPlan       StudyPlan         @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@index([studyPlanId])
}

model Subject {
  id                     String                  @id
  handbookVersionId      String
  code                   String
  name                   String
  creditPoints           Int?
  description            String?
  overview               Json?
  assessment             Json?
  learningOutcomes       Json?
  offerings              Json?
  rawData                Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  academicUnit           String?
  assumedKnowledge       String?
  managingFaculty        String?
  sourceUrl              String?
  sourceYear             Int?
  studyLevel             String?
  RequirementItem        RequirementItem[]
  StudyPlanItem          StudyPlanItem[]
  HandbookVersion        HandbookVersion         @relation(fields: [handbookVersionId], references: [id], onDelete: Cascade)
  SubjectAccessCondition SubjectAccessCondition?
  SubjectRequisiteItem   SubjectRequisiteItem[]

  @@unique([handbookVersionId, code])
  @@index([code])
  @@index([sourceYear])
}

model SubjectAccessCondition {
  id                    String                  @id
  handbookVersionId     String
  subjectId             String?                 @unique
  subjectCode           String
  subjectName           String?
  hasConditions         Boolean
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  HandbookVersion       HandbookVersion         @relation(fields: [handbookVersionId], references: [id], onDelete: Cascade)
  Subject               Subject?                @relation(fields: [subjectId], references: [id])
  SubjectRequisiteGroup SubjectRequisiteGroup[]

  @@unique([handbookVersionId, subjectCode])
  @@index([subjectCode])
}

model SubjectRequisiteGroup {
  id                     String                 @id
  groupType              RequisiteGroupType
  rule                   String?
  sortOrder              Int?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime
  accessConditionId      String
  authoritative          Boolean?
  containsUnparsedText   Boolean?
  rawData                Json?
  SubjectAccessCondition SubjectAccessCondition @relation(fields: [accessConditionId], references: [id], onDelete: Cascade)
  SubjectRequisiteItem   SubjectRequisiteItem[]

  @@index([accessConditionId])
  @@index([groupType])
}

model SubjectRequisiteItem {
  id                    String                @id
  requisiteGroupId      String
  itemKey               String
  requisiteType         String?
  details               String
  referencedSubjectId   String?
  referencedComponentId String?
  referencedDegreeId    String?
  rawReferencedCodes    Json?
  sortOrder             Int?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime
  rawData               Json?
  Component             Component?            @relation(fields: [referencedComponentId], references: [id])
  Degree                Degree?               @relation(fields: [referencedDegreeId], references: [id])
  Subject               Subject?              @relation(fields: [referencedSubjectId], references: [id])
  SubjectRequisiteGroup SubjectRequisiteGroup @relation(fields: [requisiteGroupId], references: [id], onDelete: Cascade)

  @@index([referencedComponentId])
  @@index([referencedDegreeId])
  @@index([referencedSubjectId])
  @@index([requisiteGroupId])
}

model University {
  id              String            @id
  code            String            @unique
  name            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  HandbookVersion HandbookVersion[]
}

model UnresolvedReference {
  id                String          @id
  handbookVersionId String
  sourceEntityType  String?
  sourceEntityCode  String?
  targetType        String?
  targetCode        String?
  targetName        String?
  sourceUrl         String?
  reason            String?
  createdAt         DateTime        @default(now())
  HandbookVersion   HandbookVersion @relation(fields: [handbookVersionId], references: [id], onDelete: Cascade)

  @@index([handbookVersionId])
  @@index([targetCode])
}

enum ComponentType {
  MAJOR
  MINOR
  SUB_MAJOR
  STREAM
  SPECIALISATION
  MAJOR_EXTENSION
  CHOICE_BLOCK
  ELECTIVE_POOL
  GENERAL_EDUCATION
  CAPSTONE
  HONOURS
  PLACEMENT
  OTHER
  PROGRAM
}

enum RequirementItemType {
  SUBJECT
  COMPONENT
  OTHER
  TABLE
  RAW
}

enum RequirementLogic {
  ALL
  ANY
  ONE_OF
  UNKNOWN
}

enum RequisiteGroupType {
  REQUISITE
  ANTI_REQUISITE
  PREREQUISITE
  COREQUISITE
  PROHIBITION
}

enum StudyPlanItemType {
  SUBJECT
  CHOICE
}

enum RiasecCode {
  REALISTIC
  INVESTIGATIVE
  ARTISTIC
  SOCIAL
  ENTERPRISING
  CONVENTIONAL
}

enum AssessmentStage {
  SCREENING
  DRILL_DOWN
  COMPLETED
}

model RiasecCategory {
  id                String              @id
  code              RiasecCode          @unique
  name              String
  description       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  RiasecSubcategory RiasecSubcategory[]
  RiasecScore       RiasecScore[]
  Question          Question[]
}

model RiasecSubcategory {
  id                     String                   @id
  categoryId             String
  code                   String
  name                   String
  description            String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  RiasecCategory         RiasecCategory           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  RiasecSubcategoryScore RiasecSubcategoryScore[]
  Question               Question[]

  @@unique([categoryId, code])
  @@index([categoryId])
}

model Question {
  id                 String               @id
  stage              AssessmentStage
  categoryId         String
  subcategoryId      String?
  text               String
  sortOrder          Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  RiasecCategory      RiasecCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  RiasecSubcategory   RiasecSubcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  AssessmentResponse  AssessmentResponse[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([stage])
}

model AssessmentSession {
  id                 String               @id
  stage              AssessmentStage      @default(SCREENING)
  topCategoryIds     String[]
  expiresAt          DateTime
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  AssessmentResponse AssessmentResponse[]

  @@index([expiresAt])
}

model AssessmentResponse {
  id                String            @id
  sessionId         String
  questionId        String
  value             Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  AssessmentSession AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  Question          Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([questionId])
}

model RiasecScore {
  id             String         @id
  degreeId       String?
  componentId    String?
  categoryId     String
  score          Float
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  Degree         Degree?        @relation(fields: [degreeId], references: [id], onDelete: Cascade)
  Component      Component?     @relation(fields: [componentId], references: [id], onDelete: Cascade)
  RiasecCategory RiasecCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([degreeId, componentId, categoryId])
  @@index([componentId])
  @@index([categoryId])
}

model RiasecSubcategoryScore {
  id                String            @id
  degreeId          String?
  componentId       String?
  subcategoryId     String
  score             Float
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  Degree            Degree?           @relation(fields: [degreeId], references: [id], onDelete: Cascade)
  Component         Component?        @relation(fields: [componentId], references: [id], onDelete: Cascade)
  RiasecSubcategory RiasecSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([degreeId, componentId, subcategoryId])
  @@index([componentId])
  @@index([subcategoryId])
}
